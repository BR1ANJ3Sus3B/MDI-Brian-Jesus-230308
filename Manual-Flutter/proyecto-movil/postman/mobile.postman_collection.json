{
  "info": {
    "name": "Laboratorio móvil",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Configura OAuth 2.0 Authorization Code con PKCE según el capítulo 25. Guarda access_token solo localmente; no exportes valores reales."
  },
  "item": [
    {
      "name": "API pública",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      }
    },
    {
      "name": "Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Perfil",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Listar tareas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/tasks",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Crear tarea",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/tasks",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Preparar exposición\",\n  \"completed\": false,\n  \"category_id\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Creada', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.environment.set('task_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Editar tarea",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/tasks/{{task_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Exposición preparada\",\n  \"completed\": true,\n  \"category_id\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Eliminar tarea",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/tasks/{{task_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Categorías",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/categories",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Listar usuarios (admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Crear usuario educativo (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Alex\",\n  \"correo\": \"alex@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Actividad (admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/admin/activity",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Token inválido",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid-token"
          }
        ],
        "url": "{{base_url}}/tasks"
      }
    }
  ]
}

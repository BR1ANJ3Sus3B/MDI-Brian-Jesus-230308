# Copiar a .env y sustituir las contraseñas antes del primer arranque.
COMPOSE_FILE=infrastructure/docker-compose.yml
COMPOSE_PROJECT_NAME=manual_mobile
BACKEND_CONTEXT=../backend
POSTGRES_DB=app_mobile
POSTGRES_USER=developer
POSTGRES_PASSWORD=cambiar_postgres_app
POSTGRES_ADMIN_PASSWORD=cambiar_postgres_admin
MONGO_URL=mongodb://mongo:27017/app_mobile
MONGO_PORT=27017
MONGO_USER=developer
MONGO_PASSWORD=cambiar_mongo_app
MONGO_ROOT_PASSWORD=cambiar_mongo_admin
KEYCLOAK_DB_PASSWORD=cambiar_keycloak_db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_keycloak_admin
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
